; bare position + colour passthrough, only used by the startup GPU test

.fvec projection[4]

.constf consts(1.0, 0.0, 0.0, 0.0)
.alias one consts.xxxx

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w, one

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outclr, inclr
	end
.end
